                }
              }
            }
          ]
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "current_attempt"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "current_attempt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "stage",
          "message",
          "retryable",
          "attempt",
          "timestamp"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_INVALID",
              "SCHEMA_INVALID",
              "INPUT_HASH_MISMATCH",
              "NETWORK_TIMEOUT",
              "GPU_OOM",
              "MODEL_LOAD_FAILED",
              "BLENDER_PROCESS_FAILED",
              "OUTPUT_INVALID",
              "QUALITY_REJECTED",
              "PUBLISH_FAILED",
              "DRIVE_SYNC_FAILED"
            ]
          },
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "attempt": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}